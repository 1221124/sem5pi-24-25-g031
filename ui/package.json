    "@angular/forms": "^18.2.*",
    "@angular/platform-browser": "^18.2.*",
    "@angular/platform-browser-dynamic": "^18.2.*",
    "@angular/platform-server": "^18.2.*",
    "@angular/router": "^18.2.*",
    "@angular/ssr": "^18.2.*",
    "ajv": "^8.17.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "jwt-decode": "^4.0.0",
    "marked": "^15.0.4",
